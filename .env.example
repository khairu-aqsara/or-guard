# Copy to .env and fill in. Variables set in the shell win over this file.

# OpenRouter Management API key. Without it, scan works but you cannot pick or change a policy.
OPENROUTER_MANAGEMENT_KEY=

# Optional. Set to true to post a notice after each apply that changes the allowlist.
# The bot needs chat:write and must be a member of the channel.
ENABLE_SLACK_NOTIFICATION=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
